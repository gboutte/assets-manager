# Server
HOST=0.0.0.0
PORT=8000

# Authentication
# Every variable starting with API_TOKEN is a valid token (empty values are ignored)
API_TOKEN=your-secret-token-here
# API_TOKEN_CI=another-token

# Storage
STORAGE_TYPE=filesystem
STORAGE_PATH=./upload

# Cache: Cache-Control max-age in seconds for served assets (default: 1 year, 0 = no-cache)
# Assets are sent as immutable: upload new files under a new tag rather than overwriting a tag
# CACHE_MAX_AGE=31536000

# Per-domain storage: assets are stored in <STORAGE_PATH>/<host>/<tag>/ and only served on that host
# Requests for a host that is not in ALLOWED_HOSTS get a 404 (except /health)
# STORAGE_PER_HOST=true
# ALLOWED_HOSTS=assets.domain1.com,assets.domain2.com

# Stats database (SQLite): upload date and hits of each tag, used by the auto-cleanup
# Hits are counted in memory and written every minute, and when the server stops
# DB_PATH=./upload/.assets-manager.db   (default: <STORAGE_PATH>/.assets-manager.db)

# Future: S3 storage
# STORAGE_TYPE=s3
# S3_BUCKET=my-assets-bucket
# S3_REGION=eu-west-1
# S3_ACCESS_KEY=xxx
# S3_SECRET_KEY=xxx

# Auto-cleanup: a tag is deleted when it is too old OR unused for too long,
# unless it is one of the KEEP_LAST most recent uploads or matches KEEP_TAGS.
# No MAX_AGE / MAX_IDLE rule = nothing is ever deleted. Rules apply per domain with STORAGE_PER_HOST.
# CLEANUP_MAX_AGE_DAYS=90        # uploaded more than 90 days ago (0 + KEEP_LAST = keep only the last N)
# CLEANUP_MAX_IDLE_DAYS=30       # not served for 30 days (counted from the upload if never served)
# CLEANUP_KEEP_LAST=5            # always keep the 5 most recent uploads
# CLEANUP_KEEP_TAGS=prod,v1.*    # always keep these tags ('*' matches anything)
# CLEANUP_INTERVAL_MINUTES=60    # first run one interval after startup, 0 = no background task
# CLEANUP_DRY_RUN=true           # only log what would be deleted
